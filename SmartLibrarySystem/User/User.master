<%@ Master Language="C#" AutoEventWireup="true" CodeFile="User.master.cs" Inherits="UserMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server"></asp:ContentPlaceHolder> - Student Portal</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="~/assets/css/styles.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="wrapper">
            <!-- Sidebar -->
            <aside class="sidebar d-flex flex-column">
                <div class="brand text-secondary">
                    <i class="fas fa-graduation-cap"></i> Student Portal
                </div>
                
                <nav class="mt-4 flex-grow-1">
                    <a href="Dashboard.aspx" class="nav-link"><i class="fas fa-home w-20px"></i> Overview</a>
                    <a href="Catalog.aspx" class="nav-link"><i class="fas fa-search w-20px"></i> Browse Catalog</a>
                    <a href="MyBooks.aspx" class="nav-link"><i class="fas fa-book-reader w-20px"></i> My Books</a>
                </nav>

                <div class="mt-auto">
                    <button type="button" id="theme-toggle" class="theme-toggle mb-3">
                        <i class="fas fa-moon"></i> Theme
                    </button>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="nav-link text-danger" OnClick="btnLogout_Click">
                        <i class="fas fa-sign-out-alt w-20px"></i> Logout
                    </asp:LinkButton>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="main-content">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold"><asp:ContentPlaceHolder ID="HeaderContent" runat="server"></asp:ContentPlaceHolder></h2>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted fw-bold">Welcome, <%= Session["FullName"] %></span>
                        <img src="https://ui-avatars.com/api/?name=<%= Session["FullName"] %>&background=10B981&color=fff" class="rounded-circle" width="40" alt="Student" />
                    </div>
                </div>

                <div class="glass-panel p-4 animate-fade-in">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </main>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/assets/js/app.js"></script>
    
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
