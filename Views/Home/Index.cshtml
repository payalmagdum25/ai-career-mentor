@{
    ViewData["Title"] = "Home";
}

<div class="hero-section animate-fade-in">
    <h1 class="hero-title">Elevate Your Career <br /> Starting Today.</h1>
    <p class="lead text-muted mx-auto" style="max-width: 600px;">
        The all-in-one platform to find your dream job and master the skills needed to get there. From DSA to HR rounds, we've got you covered.
    </p>
    <div class="mt-5">
        <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary btn-lg me-3">Explore Jobs</a>
        <a asp-controller="Prep" asp-action="Index" class="btn btn-outline-light btn-lg">Start Preparing</a>
    </div>
</div>

<div class="feature-grid mt-5">
    <div class="glass-card text-center">
        <div class="mb-4">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
        </div>
        <h3>Job Portal</h3>
        <p class="text-muted">Curated job listings from top tech companies across the globe.</p>
    </div>
    <div class="glass-card text-center">
        <div class="mb-4">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        </div>
        <h3>Preparation Hub</h3>
        <p class="text-muted">Comprehensive notes and practice problems for Aptitude, DSA, and Technical rounds.</p>
    </div>
    <div class="glass-card text-center">
        <div class="mb-4">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <h3>Company Insights</h3>
        <p class="text-muted">Detailed hiring processes, eligibility criteria, and interview patterns for top firms.</p>
    </div>
</div>
